# Variables d'environnement ORION — Frontend

# ============================================================
# Copier ce fichier en .env.local pour le développement
# Ne JAMAIS commiter le fichier .env.local
# ============================================================

# URL du backend REST ORION (NestJS)
# En dev local : http://localhost:3001
# En production : https://api.orion.votredomaine.com
VITE_API_URL=http://localhost:3001

# URL du serveur WebSocket ORION
# En dev local : ws://localhost:3001
# En production : wss://api.orion.votredomaine.com
VITE_WS_URL=ws://localhost:3001

# Environnement d'exécution
# Valeurs : development | staging | production
VITE_APP_ENV=development
